<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.webServer>
    <!-- Indicates that the server.js file is a node.js site to be handled by the iisnode module -->
    <webSocket enabled="false" />
    <iisnode 
      nodeProcessCommandLine="&quot;%PROGRAMFILES%\nodejs\node.exe&quot;" 
      loggingEnabled="true"
      logDirectory="..\..\LogFiles\nodejs"
      debuggingEnabled="false"
      maxNamedPipeConnectionRetry="3"
      appendToExistingLog="false"
      maxLogFileSizeInKB="10485760"
      maxTotalLogFileSizeInKB="104857600"
      watchedFiles="*.js;iisnode.yml"
    />
    
    <!-- First we consider whether the incoming URL matches a physical file in the /public folder -->
    <rewrite>
      <rules>
        <!-- All files in the public folder are mapped to the public URL path (relative to the root of the site root) -->
        <rule name="StaticContent">
          <action type="Rewrite" url="public{REQUEST_URI}" />
        </rule>

        <!-- 'Missing web.config' rules blocks access to the following directories and files. This improves security
             by preventing access to system files that web servers such as Apache and Nginx use to store configuration.

             If you want to allow Git Deployments and status checks (temporary files generated by post
             deployment operation), uncomment the following rules accordingly. -->
        <rule name="Hide Logs Folder">
          <match url="^logs" />
          <action type="AbortRequest" />
        </rule>

        <rule name="Hide node_modules Folder">
          <match url="^node_modules" />
          <action type="AbortRequest" />
        </rule>

        <!-- All the routes other than those mapped to files, goes to our Express.js application to handle -->
        <rule name="DynamicContent">
          <conditions>
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="True" />
          </conditions>
          <action type="Rewrite" url="server.js" />
        </rule>
      </rules>
    </rewrite>

    <!-- 'Missing web.config' module handlers removes the need of specifying the default handler explicitly -->
    <handlers>
      <!-- Indicates that the server.js file is a node.js site to be handled by the iisnode module -->
      <add name="iisnode" path="server.js" verb="*" modules="iisnode" resourceType="Unspecified" requireAccess="Script" />
      <!-- Do not interfere with requests for node.js content that arrives via the standard routes -->
      <add name="StaticFile" path="*" verb="*" modules="StaticFileModule,DefaultDocumentModule,DirectoryListingModule" resourceType="Either" requireAccess="Read" />
    </handlers>

    <!-- Configure how failed requests are handled by iisnode -->
    <httpErrors>
      <remove statusCode="404" />
      <remove statusCode="405" />
      <error statusCode="404" path="server.js" responseMode="ExecuteResponse" />
      <error statusCode="405" path="server.js" responseMode="ExecuteResponse" />
    </httpErrors>

    <!-- Modules that handles requests for node.js apps and cache the responses -->
    <caching>
      <staticContent>
        <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="3.00:00:00" />
      </staticContent>
    </caching>

  </system.webServer>
</configuration>
